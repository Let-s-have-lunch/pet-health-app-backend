// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

enum UserRole {
  USER
  ADMIN
}

enum PetGender {
  MALE
  FEMALE
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  nickname String
  password String
  email    String @unique

  birthdate DateTime
  role      UserRole @default(USER)
  pets      Pet[]
}

model Pet {
  id                 Int       @id @default(autoincrement())
  species            String
  breed              String?
  name               String
  birthdate          DateTime?
  registrationNumber String?   @unique
  gender             PetGender @default(FEMALE)
  neutered           Boolean   @default(false)
  profileImage       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  diaries Diary[]
  todos   Todo[]

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Diary {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  diaryImage String?
  date       DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  petId Int
  pet   Pet @relation(fields: [petId], references: [id])

  @@index([petId])
}

model Todo {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  petId Int
  pet   Pet @relation(fields: [petId], references: [id])

  @@index([petId])
}
