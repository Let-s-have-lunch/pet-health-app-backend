// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

enum RoleType {
  USER
  ADMIN
}

enum PetGender {
  MALE
  FEMALE
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  nickname String @unique
  password String
  email    String @unique

  birthdate      DateTime?
  role           RoleType        @default(USER)
  pets           Pet[]
  inquiries      Inquiry[]
  communityPosts CommunityPost[]
  replies        Reply[]
  diaries        Diary[]
  todos          Todo[]
}

model Pet {
  id                 Int       @id @default(autoincrement())
  species            String
  breed              String?
  name               String
  birthdate          DateTime?
  registrationNumber String?   @unique
  gender             PetGender @default(FEMALE)
  neutered           Boolean   @default(false)
  profileImage       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  walkLogs   WalkLog[]
  vetRecords VetRecord[]
  weightLogs WeightLog[]
  waterLogs  WaterLog[]

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Diary {
  id         Int     @id @default(autoincrement())
  title      String
  content    String
  diaryImage String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Todo {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  role        RoleType @default(USER)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Notice {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  title      String
  content    String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  userId     Int
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WalkLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  walkDate  DateTime
  startTime DateTime
  endTime   DateTime

  duration Int
  distance Float?

  memo  String?
  petId Int
  pet   Pet     @relation(fields: [petId], references: [id])

  @@index([petId])
  @@index([walkDate])
}

model VetRecord {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visitDate    DateTime
  hospitalName String
  visitPurpose String
  diagnosis    String?
  treatment    String?
  cost         Int      @default(0)
  receiptImage String?
  memo         String?
  petId        Int
  pet          Pet      @relation(fields: [petId], references: [id])

  @@index([petId])
  @@index([visitDate])
}

model WeightLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recordDate DateTime // 몸무게를  측정한 날짜
  weight     Float // 몸무게

  memo  String?
  petId Int // 어떤 반려동물인지
  pet   Pet     @relation(fields: [petId], references: [id])

  @@index([petId])
  @@index([recordDate])
}

// 음수량에 대한 테이블
model WaterLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recordDate DateTime
  amount     Int

  memo  String?
  petId Int
  pet   Pet     @relation(fields: [petId], references: [id])

  @@index([petId])
  @@index([recordDate])
}

model CommunityPost {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  title     String
  content   String    @db.Text
  views     Int       @default(0)
  userId    Int
  user      User      @relation(fields: [userId], references: [id])

  replies Reply[]

  @@index([userId])
}

model Reply {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String   @db.Text

  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  communityPostId Int
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id])

  @@index([userId])
  @@index([communityPostId])
}
