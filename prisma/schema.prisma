// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "prisma"
}

enum RoleType {
  USER
  ADMIN
}

enum PetGender {
  MALE
  FEMALE
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  nickname String @unique
  password String
  email    String @unique

  birthdate DateTime
  role      RoleType  @default(USER)
  pets      Pet[]
  inquiries Inquiry[]
  walkLogs  WalkLog[]
}

model Pet {
  id                 Int       @id @default(autoincrement())
  species            String
  breed              String?
  name               String
  birthdate          DateTime?
  registrationNumber String?   @unique
  gender             PetGender @default(FEMALE)
  neutered           Boolean   @default(false)
  profileImage       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  diaries Diary[]
  todos   Todo[]

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Diary {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  diaryImage String?
  date       DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  petId Int
  pet   Pet @relation(fields: [petId], references: [id])

  @@index([petId])
}

model Todo {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  petId     Int
  pet       Pet       @relation(fields: [petId], references: [id])
  birthdate DateTime?
  role      RoleType  @default(USER)

  inquiries Inquiry[]

  @@index([petId])
}

model Notice {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  title      String
  content    String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  userId     Int
  user       User      @relation(fields: [userId], references: [id])
  todo       Todo?     @relation(fields: [todoId], references: [id])
  todoId     Int?

  @@index([userId])
}

model WalkLog {
  id Int @id @default(autoincrement())

  time   Int
  userId Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id]) //

  walkDate  DateTime
  startTime DateTime
  endTime   DateTime

  duration Int
  distance Float?

  memo  String?
  petId Int

  @@index([petId])
  @@index([walkDate])
}

model VetRecord {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visitDate    DateTime
  hospitalName String
  visitPurpose String
  diagnosis    String?
  treatment    String?
  cost         Int?
  receiptImage String?
  memo         String?
  petId        Int

  @@index([petId])
  @@index([visitDate])
}

model WeightLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recordDate DateTime // 몸무게를  측정한 날짜
  weight     Float // 몸무게

  memo  String?
  petId Int // 어떤 반려동물인지

  @@index([petId])
  @@index([recordDate])
}

// 음수량에 대한 테이블
model WaterLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recordDate DateTime
  amount     Int

  memo  String?
  petId Int

  @@index([petId])
  @@index([recordDate])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  userId    Int
  replies   Reply[] // 💡 게시글 하나에 여러 댓글이 달릴 수 있음!
  createdAt DateTime @default(now())
}

model Reply {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 💡 외래키 설정: 이 댓글이 어느 게시글에 속하는지 명시
  post Post @relation(fields: [postId], references: [id])
}

// 1. 반려동물 카테고리 정의 (코드에서의 타입과 일치시킵니다)
enum Category {
  HEALTH
  NUTRITION
  BEHAVIOR
  GROOMING
  ADOPTION // 추가: 내장칩, 등록, 입양 관련
  WALKING // 추가: 산책 예절, 산책 코스, 외출 관련
  ETC
}

// 2. 반려동물 종류 정의 (선택사항이지만 매우 유용합니다)
enum PetType {
  DOG
  CAT
  SMALL_ANIMAL
  ETC
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faqs")
}
