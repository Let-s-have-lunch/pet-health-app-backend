// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RoleType {
  USER
  ADMIN
}

model User {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  nickname String @unique
  password String
  email    String @unique

  birthdate DateTime?
  role      RoleType  @default(USER)

  inquiries Inquiry[]
}

model Notice {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  title      String
  content    String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  userId     Int
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WalkLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  walkDate  DateTime
  startTime DateTime
  endTime   DateTime

  duration Int
  distance Float?

  memo  String?
  petId Int

  @@index([petId])
  @@index([walkDate])
}

model VetRecord {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  visitDate    DateTime
  hospitalName String
  visitPurpose String
  diagnosis    String?
  treatment    String?
  cost         Int?
  receiptImage String?
  memo         String?
  petId        Int

  @@index([petId])
  @@index([visitDate])
}

model WeightLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recordDate DateTime // 몸무게를  측정한 날짜
  weight     Float // 몸무게

  memo  String?
  petId Int // 어떤 반려동물인지

  @@index([petId])
  @@index([recordDate])
}

// 음수량에 대한 테이블
model WaterLog {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recordDate DateTime
  amount     Int

  memo  String?
  petId Int

  @@index([petId])
  @@index([recordDate])
}
